{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "command-rdev-center",
  "version": "0.1.37",
  "identifier": "com.rifkioktapratama.command-rdev-center",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Command rdev Center",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGRkZDNDQwRTZGNjBFN0EKUldSNkR2Ym1RTVQvZjBKMDcxa1E2dG9Kc29nTjk0azdnQ2M0WGF1V3BEaERUZW83UzFzeC9uL0cK",
      "endpoints": [
        "https://updates.rdev.web.id/command-rdev-center/latest.json"
      ]
    }
  }
}
