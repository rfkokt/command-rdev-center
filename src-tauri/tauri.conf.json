{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kern Studio",
  "version": "0.2.18",
  "identifier": "com.rifkioktapratama.command-rdev-center",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kern Studio",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob: asset: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https:;"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../node_modules/prettier": "node_modules/prettier",
      "browser-host/host.mjs": "browser-host/host.mjs",
      "browser-host/proxy.mjs": "browser-host/proxy.mjs",
      "browser-host/node_modules/playwright": "browser-host/node_modules/playwright",
      "browser-host/node_modules/playwright-core": "browser-host/node_modules/playwright-core",
      "browser-host/.browsers": "browser-host/.browsers",
      "browser-host/runtime/node-aarch64-apple-darwin": "browser-host/runtime/node-aarch64-apple-darwin"
    },
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGRkZDNDQwRTZGNjBFN0EKUldSNkR2Ym1RTVQvZjBKMDcxa1E2dG9Kc29nTjk0azdnQ2M0WGF1V3BEaERUZW83UzFzeC9uL0cK",
      "endpoints": [
        "https://updates.rdev.web.id/command-rdev-center/latest.json"
      ]
    }
  }
}
